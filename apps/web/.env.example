DATABASE_URL="postgresql://postgres:mederp_dev@localhost:5432/mederp?schema=public"
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"

# Production on HTTP (EC2 public IP) must be 0 so login cookies work. Use 1 behind HTTPS.
# COOKIE_SECURE="0"
#
# After mederp.co.in DNS works, Caddy issues a Let's Encrypt cert. Then use:
# NEXT_PUBLIC_API_URL="https://mederp.co.in"
# NEXT_PUBLIC_SOCKET_URL="https://mederp.co.in"
# WHATSAPP_MEDIA_BASE_URL="https://mederp.co.in"
# COOKIE_SECURE="1"
# SITE_ADDRESS="mederp.co.in,www.mederp.co.in"
# ACME_EMAIL="you@mederp.co.in"

# Razorpay — use test keys from dashboard.razorpay.com (never commit real secrets)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="change_me"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="change_me"
# Optional: one plan per tier (amount = base + 18% GST). App creates a plan if missing/mismatch.
# RAZORPAY_PLAN_ID_CLINIC="plan_xxxx"   # ₹2949 (₹2499 + 18% GST)
# RAZORPAY_PLAN_ID_STARTER="plan_xxxx"  # ₹5309 (₹4499 + 18% GST)
# RAZORPAY_PLAN_ID_GROWTH="plan_xxxx"   # ₹7079 (₹5999 + 18% GST)
# RAZORPAY_PLAN_ID="plan_xxxx"          # legacy single-plan fallback

# OTP_DUMMY="0"

# AskEva Consumer API — Dashboard → Settings → API Settings → Create New API Key
# ASKEVA_API_URL="https://backend.askeva.io/v1"
# ASKEVA_API_TOKEN=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_TEMPLATE_LANG="en,en_IN"
# WHATSAPP_OTP_TEMPLATE="as"
# WHATSAPP_OTP_CODE_LABEL="Code"
# WHATSAPP_REMINDER_PARAMS="named"
#
# Create each template in WhatsApp Manager for English (India) en_IN and English en.
# App tries languages in WHATSAPP_TEMPLATE_LANG order (default en_IN,en).
# Do not start or end a Utility body with a variable.
#
# UTILITY — login access number (tier 0 cannot use Authentication templates)
# Name: as
# Category: Utility
# Do not write OTP, passcode, or verification in the template.
# Hello, {{patientname}} is {{birthyear}}.
# Thanks for choosing mederp.
# Samples: patientname=Code, birthyear=123456
#
# UTILITY — appointment_reminder (named vars)
# Hello {{patient_name}},
#
# This is a reminder about your upcoming appointment with {{doctor_name}} on {{appointment_date}} at {{appointment_time}}.
#
# We look forward to seeing you!
# Set WHATSAPP_REMINDER_PARAMS=positional only if this template still uses {{1}}..{{4}}.
#
# UTILITY — bill_receipt (HEADER = Document / PDF sample required + body)
# Hi {{patient_name}}, thank you for visiting {{hospital_name}}. Your bill receipt {{invoice_no}} is attached as a PDF. The net total for this visit is {{total_amount}}. Please keep this receipt for your records. If you have any billing questions, contact the hospital front desk.
#
# investigation_list (HEADER = Document / PDF sample required + body):
# Hi {{patient_name}}, {{hospital_name}} has listed tests/scans for you: {{test_list}}. The investigation request is attached as a PDF. Please follow the doctor's advice.
#
# visit_summary (HEADER = Document / PDF sample required + body):
# Hi {{patient_name}}, your visit summary from {{hospital_name}} with {{doctor_name}} on {{visit_when}} is attached. Please follow the doctor's advice.
#
# WHATSAPP_REMINDER_TEMPLATE="appointment_reminder1"
# WHATSAPP_INVESTIGATION_TEMPLATE="investigation_list"
# WHATSAPP_VISIT_SUMMARY_TEMPLATE="visit_summary_"
# WHATSAPP_BILL_RECEIPT_TEMPLATE="billpreceipt"
#
# UTILITY — subscription_bill (HEADER = Document / PDF sample required + body)
# Sent to the hospital SUPER_ADMIN mobile on each successful monthly Razorpay renewal.
# Hi {{admin_name}}, the MedERP subscription for {{hospital_name}} renewed successfully. Invoice {{invoice_no}} for {{total_amount}} covering {{billing_period}} is attached as a PDF. Please keep this bill for your software records.
# Samples: admin_name=Dr Sharma, hospital_name=City Clinic, invoice_no=MEDERP-INV-00012, total_amount=₹4,000.00, billing_period=19 Sep 2026 – 18 Oct 2026
# WHATSAPP_SUBSCRIPTION_BILL_TEMPLATE="subscription_bill"
#
# AskEva downloads the PDF from this public URL. localhost always fails.
# When this host differs from NEXT_PUBLIC_API_URL, MedERP copies the PDF there first.
# WHATSAPP_MEDIA_BASE_URL="http://18.61.210.135"
