DATABASE_URL="postgresql://postgres:mederp_dev@localhost:5432/mederp?schema=public"
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"

# Production on HTTP (EC2 public IP) must be 0 so login cookies work. Use 1 behind HTTPS.
# COOKIE_SECURE="0"

# Razorpay — use test keys from dashboard.razorpay.com (never commit real secrets)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="change_me"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="change_me"

# OTP_DUMMY="0"

# WhatsApp Cloud API — templates must be approved in Meta.
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_BUSINESS_ACCOUNT_ID=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_TEMPLATE_LANG="en_IN,en"
# WHATSAPP_GRAPH_VERSION="v22.0"
# WHATSAPP_OTP_TEMPLATE="validation"
# WHATSAPP_OTP_COPY_CODE="1"
#
# Create each template in Meta for English (India) en_IN and English en when possible.
# App tries languages in WHATSAPP_TEMPLATE_LANG order (default en_IN,en).
# Utility templates below use NAMED vars unless noted. Do not start or end body with a variable.
#
# appointment_reminder (positional {{1}}..{{4}} — matches approved Meta body):
# Hello {{1}},
#
# This is a reminder about your upcoming appointment with {{2}} on {{3}} at {{4}}.
#
# We look forward to seeing you!
# ({{1}}=patient, {{2}}=doctor, {{3}}=date, {{4}}=time)
#
# investigation_list (text only):
# Hi {{patient_name}}, {{hospital_name}} has listed tests/scans for you: {{test_list}}. Please follow the doctor's advice.
#
# visit_summary (HEADER = Document / PDF sample required + body):
# Hi {{patient_name}}, your visit summary from {{hospital_name}} with {{doctor_name}} on {{visit_when}} is attached. Please follow the doctor's advice.
#
# bill_receipt (HEADER = Document / PDF sample required + body):
# Hi {{patient_name}}, thank you for visiting {{hospital_name}}. Your bill receipt {{invoice_no}} is attached as a PDF. The net total for this visit is {{total_amount}}. Please keep this receipt for your records. If you have any billing questions, contact the hospital front desk.
#
# WHATSAPP_REMINDER_TEMPLATE="appointment_reminder"
# WHATSAPP_INVESTIGATION_TEMPLATE="investigation_list"
# WHATSAPP_VISIT_SUMMARY_TEMPLATE="visit_summary"
# WHATSAPP_BILL_RECEIPT_TEMPLATE="bill_receipt"
